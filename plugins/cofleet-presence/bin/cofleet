#!/bin/sh
# Cofleet plugin entrypoint.
#
# A shell shim in front of the Node implementation for one reason: when node is
# missing this must be a SILENT no-op, not an error. `UserPromptSubmit` is a
# blocking hook — a non-zero exit there puts a line in the teammate's transcript
# on every single prompt, and a presence feature that nags is a presence feature
# that gets uninstalled. Absent node, presence is simply unavailable.
#
# Always exits 0. Never writes to stderr. See bin/cofleet.mjs for the contract.

if ! command -v node >/dev/null 2>&1; then
  exit 0
fi

exec node "$(dirname "$0")/cofleet.mjs" "$@"
